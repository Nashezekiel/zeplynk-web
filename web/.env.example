# Password required to log into /admin and manage Insights posts.
ADMIN_PASSWORD=

# Optional: secret used to sign the admin session cookie.
# Falls back to ADMIN_PASSWORD if omitted, but a separate long random value is safer.
ADMIN_SESSION_SECRET=

# Upstash Redis (https://upstash.com) — free tier is enough for this use case.
# Required in production (Vercel) so posts created/edited in /admin persist.
# Without these set, the site falls back to the read-only seed data in constants/news.ts
# and /admin will error when trying to save changes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
