# Password required to log into /admin and manage Insights posts and Testimonials.
ADMIN_PASSWORD=

# Optional: secret used to sign the admin session cookie.
# Falls back to ADMIN_PASSWORD if omitted, but a separate long random value is safer.
ADMIN_SESSION_SECRET=

# Supabase (https://supabase.com) — free tier is enough for this use case.
# Backs both Insights (blog) posts and the Testimonials/feedback moderation queue.
# Server-only — never expose the service role key to the client.
# Without these set, /news falls back to the read-only seed data in constants/news.ts,
# the Testimonials section on the homepage stays hidden, and /admin will error on writes.
# Run the SQL in supabase-schema.sql (project root) against your Supabase project first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
